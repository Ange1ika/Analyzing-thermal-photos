{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build with OpenCV",
            "command": "/usr/bin/bash",
            "args": [
                "-c",
                "g++ -fdiagnostics-color=always -std=c++17 -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" $(pkg-config --cflags --libs opencv4) -lstdc++fs"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}