import cv2
import numpy as np
import matplotlib.pyplot as plt

# Загрузка изображения в градациях серого
img = cv2.imread("/home/angelika/Desktop/8_term/R_D/General_C/DATA/08_04/General_thermo.png", cv2.IMREAD_GRAYSCALE)

# Применение CLAHE
clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
final_img = clahe.apply(img)

# Отображение оригинала и результата CLAHE
plt.figure(figsize=(10, 5))

plt.subplot(1, 2, 1)
plt.imshow(img, cmap='gray')
plt.title("Оригинальное изображение")
plt.axis('off')

plt.subplot(1, 2, 2)
plt.imshow(final_img, cmap='gray')
plt.title("После CLAHE")
plt.axis('off')

plt.tight_layout()
plt.show()

# Вычисление гистограммы и нормализованной функции распределения
hist, bins = np.histogram(final_img.flatten(), 256, [0, 256])
cdf = hist.cumsum()
cdf_normalized = cdf * float(hist.max()) / cdf.max()

# Построение графика гистограммы и CDF
plt.figure(figsize=(10, 5))
plt.xlabel("Значение интенсивности пикселей")
plt.ylabel("Частота / Накопленное распределение")
plt.plot(cdf_normalized, color='b', label='Функция распределения')
plt.hist(final_img.flatten(), 256, [0, 256], color='r', alpha=0.6, label='Гистограмма')
plt.xlim([0, 256])
plt.legend(loc='upper left')
plt.title("Результат CLAHE и гистограмма")
plt.show()

